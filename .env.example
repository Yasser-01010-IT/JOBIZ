# Vercel server-side settings (do not use the VITE_ prefix for these secrets)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_SECRET=replace-with-a-long-random-secret

# Optional: add the private spreadsheet link to the admin panel.
VITE_SURVEY_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id/edit
